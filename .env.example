# ─── Copy to .env and fill. Every key here is read by at least one app. ───
# CI fails if a key is read by an app but missing here (scripts/check-env.mjs).

# ─── web (apps/web) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/avida-media
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_UI_MODE_DEFAULT=multi
NEXT_PUBLIC_LOCALE=en-GB
NEXT_PUBLIC_DEVELOPMENT_SLUG=seed-dev
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
REVALIDATE_SECRET=dev-revalidate-secret-change-me

# ─── api (apps/api) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://avida:avida@localhost:5432/avida?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=avida-media
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000/avida-media

RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAILS=
ADMIN_SESSION_SECRET=dev-session-secret-at-least-32-chars-long
TURNSTILE_SECRET_KEY=
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
SENTRY_DSN=

# ─── worker (apps/worker) ─────────────────────────────────────────────────
FFMPEG_PATH=
DEPTH_MODEL_PATH=
SKYBOX_API_KEY=

# ─── admin (apps/admin) ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
